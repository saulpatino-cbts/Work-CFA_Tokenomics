# Copy to .env (gitignored) and fill in. Store references to secrets, never secret values.
CFA_ENVIRONMENT=development
CFA_OIDC_ISSUER=https://your-idp.example.com
CFA_OIDC_AUDIENCE=your-audience
CFA_DATABASE_SECRET_REF=your-secret-store-reference
# Single-tenant installs: id printed by `python -m cfa_tokenomics.admin create-tenant`.
CFA_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
# Role mapping from the IdP groups claim; no matching group means no access.
CFA_OIDC_ADMIN_GROUP=your-admin-group
CFA_OIDC_USER_GROUP=your-user-group
CFA_OIDC_READER_GROUP=your-reader-group
# Optional first-admin / IdP-outage recovery identity, "<issuer>|<subject>".
# CFA_BOOTSTRAP_ADMIN=
